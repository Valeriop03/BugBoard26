@startuml
!pragma layout smetana
left to right direction
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 28
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam ranksep 90
hide methods
entity User {
  Id
  Email : string
  Role / IsActive
}
entity Issue {
  Id / Status
  CreatedById
  AssignedToId?
  DuplicateOfIssueId?
  ImagePath?
}
entity Notification {
  Id / UserId
  IssueId
  IsRead
}
User -- Issue : segnalatore
Issue -- Notification : genera
@enduml
