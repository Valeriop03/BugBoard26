      Executed DbCommand (10ms) [Parameters=[], CommandType='Text', CommandTimeout='15']&#xD;
      SELECT i."Id", i."Title", i."Description", i."Type", i."Priority", i."Status", i."CreatedById", u."Email" AS "CreatedByEmail", i."AssignedToId", u0."Email" AS "AssignedToEmail", i."DuplicateOfIssueId", i."IsArchived", i."ImagePath" IS NOT NULL AND i."ImagePath" &lt;&gt; '' AS "HasImage", i."CreatedAt", i."UpdatedAt", i."ResolvedAt"&#xD;
      FROM "Issues" AS i&#xD;
      INNER JOIN "Users" AS u ON i."CreatedById" = u."Id"&#xD;
